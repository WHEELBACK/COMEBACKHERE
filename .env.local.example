# COMEBACKHERE Local Development Environment

# Horizon API (Stellar/Soroban node)
SOROBAN_RPC_HOST=http://localhost:8000
SOROBAN_NETWORK_PASSPHRASE="Standalone Network ; February 2025"

# Redis Webhook Delivery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Rate limiting — applies to EVERY route (global middleware, /health and
# /metrics included). Buckets are per-IP, or per-X-API-Key when that header is
# present. See docs/rate-limits.md.
# REDIS_URL takes precedence for the backend rate limiter; unset means the
# limiter is per-process and in-memory.
REDIS_URL=redis://localhost:6379
RATE_LIMIT_POINTS=60
RATE_LIMIT_API_KEY_POINTS=600
RATE_LIMIT_DURATION=60

# Outbound webhooks — HMAC-SHA256 signed POSTs to WEBHOOK_URL. The signature is
# a lowercase hex digest of the raw body, sent in X-COMEBACKHERE-Signature.
# See docs/webhooks.md. Leave WEBHOOK_URL empty to disable outbound webhooks;
# WEBHOOK_SIGNING_SECRET is still required at startup.
WEBHOOK_URL=
WEBHOOK_SIGNING_SECRET=<generate-a-32-char-or-longer-secret>

# Contract Deployment
CONTRACT_ADMIN_KEY=<your_local_test_key>

# Event Consumer Configuration
WEBHOOK_REDIS_CHANNEL=contract_events
WEBHOOK_CONSUMER_ID=local_dev_consumer

# MongoDB (settlement indexer)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=comebackhere

# Treasury / token contracts
TREASURY_CONTRACT_ID=C...
USDC_CONTRACT_ID=C...
INVOICE_CONTRACT_ID=C...
SIGNER_SECRET_KEY=S...
NETWORK_PASSPHRASE="Standalone Network ; February 2025"
SOROBAN_RPC_URL=http://localhost:8000/soroban/rpc

# CORS — comma-separated allowlist of browser origins allowed to call the API.
# Each entry is a bare origin (scheme://host[:port]); no paths, trailing slash or "*".
# Requests from any other origin are rejected with 403.
CORS_ORIGINS=http://localhost:5173

# Admin key guarding /webhooks/dead-letters* (sent as the X-Admin-Key header).
ADMIN_KEY=<generate-a-long-random-admin-key>
