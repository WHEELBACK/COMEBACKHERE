# COMEBACKHERE Frontend — Local Development Environment
#
# Copy this file to .env.local and fill in the values for your local setup.
# All VITE_ variables are validated at startup by src/config.ts.
# Missing or malformed values will show a configuration error screen instead
# of letting the app start and fail later with cryptic errors.
#
# Restart the dev server (npm run dev) after changing any variable.

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------

# URL of the running comebackhere-backend (or Rust backend) instance.
# The frontend calls this for invoice lookups, disputes, refunds, etc.
VITE_API_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Stellar / Soroban network
# ---------------------------------------------------------------------------

# Soroban RPC endpoint used by the frontend to submit and simulate transactions.
# For local development this points at the Soroban Quickstart container.
VITE_SOROBAN_RPC=http://localhost:8000/soroban/rpc

# Horizon API URL used for account lookups and balance queries.
VITE_HORIZON_URL=http://localhost:8000

# Network passphrase — must match the Soroban node you are connecting to.
# Standalone:  Standalone Network ; February 2025
# Testnet:     Test SDF Network ; September 2015
# Mainnet:     Public Global Stellar Network ; September 2015
VITE_NETWORK_PASSPHRASE=Standalone Network ; February 2025

# ---------------------------------------------------------------------------
# Contract IDs
# ---------------------------------------------------------------------------
# Each value must be a valid Stellar contract ID: starts with C, 56 characters
# total, uppercase base-32 alphabet (A-Z, 2-7).
# These are set after running scripts/deploy_testnet.sh (or deploy_local.sh).
# See artifacts/addresses.json.example for the expected shape.

# Invoice contract — used for paying, cancelling, releasing escrow, etc.
VITE_INVOICE_CONTRACT_ID=C...

# Compliance contract — used for allowlist and compliance manager UI.
VITE_COMPLIANCE_CONTRACT_ID=C...
