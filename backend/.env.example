# COMEBACKHERE Backend Configuration

STELLAR_NETWORK=standalone
SOROBAN_RPC_URL=http://localhost:8000
HORIZON_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379

# Contract IDs
ADMIN_PUBLIC_KEY=G...
INVOICE_CONTRACT_ID=C...
TREASURY_CONTRACT_ID=C...
COMPLIANCE_CONTRACT_ID=C...
USDC_CONTRACT_ID=C...

# Server
HOST=0.0.0.0
PORT=3000

# Backup / restore verification (issue #977)
# Operator-run or scheduled check that restores MongoDB and Redis backups into
# scratch instances, verifies recovered data, and exits non-zero on failure.
# Run with: ./scripts/verify_backup_restore.sh
BACKUP_VERIFY_MONGO_URI=mongodb://localhost:27017
BACKUP_VERIFY_MONGO_DB=comebackhere
BACKUP_VERIFY_MONGO_RESTORE_URI=mongodb://localhost:27018
BACKUP_VERIFY_MONGO_RESTORE_DB=comebackhere_restore_verify
BACKUP_VERIFY_MONGO_BACKUP_DIR=./backups/mongo
BACKUP_VERIFY_MONGO_REQUIRED_COLLECTIONS=invoices,treasury,compliance
BACKUP_VERIFY_REDIS_URL=redis://localhost:6379
BACKUP_VERIFY_REDIS_RESTORE_URL=redis://localhost:6380
BACKUP_VERIFY_REDIS_BACKUP_FILE=./backups/redis/dump.rdb
BACKUP_VERIFY_REDIS_REQUIRED_KEYS=comebackhere:invoices,comebackhere:treasury
# Comma-separated list of trusted proxy IP addresses/CIDRs.
# X-Forwarded-For is only honored when the direct peer is in this list.
# Leave empty to ignore all forwarded headers.
TRUSTED_PROXIES=
# Seeded local testnet merchant walkthrough (issue #980)
# These values are consumed by the seeded walkthrough so a clean environment
# can create an invoice, pay it, and verify settlement deterministically.
SEED_MERCHANT_PUBLIC_KEY=G...
SEED_MERCHANT_SECRET_KEY=S...
SEED_CUSTOMER_PUBLIC_KEY=G...
SEED_CUSTOMER_SECRET_KEY=S...
SEED_INVOICE_AMOUNT=10000000
SEED_INVOICE_ASSET=USDC
SEED_INVOICE_MEMO=walkthrough-invoice
