# Lock files — not committed (each sub-package manages its own lock locally)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Rust lock file (library crates do not commit Cargo.lock)
Cargo.lock
**/Cargo.lock.bak

# Rust build artifacts
**/*.wasm

# Miscellaneous generated files
*.local
.turbo/
.parcel-cache/

# Playwright state
playwright/.auth/
playwright-report/

# Editor session files
*.swp
*.swo
*~

# macOS metadata
__MACOSX/

