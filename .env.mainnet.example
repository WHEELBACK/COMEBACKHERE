# ---------------------------------------------------------------------------
# Mainnet deployment environment template
# Copy to .env.mainnet and fill in real values before running the
# deployment workflow. Never commit the populated file.
# ---------------------------------------------------------------------------

# Network / RPC
MAINNET_RPC_URL=https://mainnet.example.org/rpc
CHAIN_ID=1

# Outbound webhooks — HMAC-SHA256 signed POSTs to WEBHOOK_URL, signature in
# X-COMEBACKHERE-Signature. See docs/webhooks.md.
WEBHOOK_URL=
WEBHOOK_SIGNING_SECRET=<generate-a-32-char-or-longer-secret>
WEBHOOK_SIGNING_SECRET_PREVIOUS=
# ---------------------------------------------------------------------------
# Contract admin keys
#
# Documented separation of duties: the invoice, treasury, and compliance
# admin keys MUST be three distinct addresses. The deployment preflight
# (scripts/preflight-admin-keys.sh) blocks the workflow when any two of
# these resolve to the same address.
#
# If key reuse is genuinely required, record an explicit approved exception
# below. The exception must reference an approval (issue/PR/ticket) and is
# echoed into the deployment log for auditability.
# ---------------------------------------------------------------------------
INVOICE_ADMIN_ADDRESS=0x0000000000000000000000000000000000000000
TREASURY_ADMIN_ADDRESS=0x0000000000000000000000000000000000000000
COMPLIANCE_ADMIN_ADDRESS=0x0000000000000000000000000000000000000000

# Set to a non-empty approval reference (e.g. "GH-1234 approved by @reviewer")
# ONLY when intentional admin-key reuse has been reviewed and approved.
# Leave empty to enforce strict separation.
ADMIN_KEY_REUSE_EXCEPTION=
