STELLAR_NETWORK=mainnet
HORIZON_URL=https://horizon.stellar.org
SOROBAN_RPC_URL=https://soroban-mainnet.stellar.org
ADMIN_PUBLIC_KEY=G...
INVOICE_CONTRACT_ID=C...
TREASURY_CONTRACT_ID=C...
COMPLIANCE_CONTRACT_ID=C...
USDC_CONTRACT_ID=C...
# Mainnet signing must happen through multi-sig/KMS. Do not place private keys here.

# Rate limiting — applies to EVERY route (global middleware, /health and
# /metrics included). Buckets are per-IP, or per-X-API-Key when that header is
# present. See docs/rate-limits.md.
REDIS_URL=redis://localhost:6379
RATE_LIMIT_POINTS=60
RATE_LIMIT_API_KEY_POINTS=600
RATE_LIMIT_DURATION=60

# Outbound webhooks — HMAC-SHA256 signed POSTs to WEBHOOK_URL, signature in
# X-COMEBACKHERE-Signature. See docs/webhooks.md.
WEBHOOK_URL=
WEBHOOK_SIGNING_SECRET=<generate-a-32-char-or-longer-secret>

# Admin key guarding /webhooks/dead-letters* (sent as the X-Admin-Key header).
ADMIN_KEY=<generate-a-long-random-admin-key>

# CORS — comma-separated allowlist of browser origins allowed to call the API.
# Each entry is a bare origin (scheme://host[:port]); no paths, trailing slash or "*".
# List only production frontends here; never use a wildcard on mainnet.
CORS_ORIGINS=https://app.your-frontend.example
